# Neon PostgreSQL
#
# DATABASE_URL — pooled connection (hostname contains "-pooler"), used at
# runtime by the Neon driver adapter in src/lib/prisma.ts.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/devstash?sslmode=require"

# DIRECT_URL — direct connection (no "-pooler"), used by the Prisma CLI for
# migrations. If you only have one connection string, set both to the same value.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/devstash?sslmode=require"
